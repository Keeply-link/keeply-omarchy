#!/usr/bin/env python3
"""Keeply OAuth helper for Omarchy plugin.

Handles the PKCE OAuth flow:
1. Generates PKCE pair (code_verifier + code_challenge)
2. Starts local HTTP server on random port
3. Opens browser to Keeply authorize page
4. Catches callback redirect, extracts code
5. Exchanges code for token
6. Outputs JSON to stdout with the access token
"""

import hashlib
import base64
import http.server
import json
import os
import secrets
import socket
import socketserver
import subprocess
import sys
import urllib.parse
import urllib.request
import threading
import signal

OAUTH_AUTHORIZE_URL = "https://app.keeply.tools/oauth/authorize"
OAUTH_TOKEN_URL = "https://api.keeply.tools/oauth/token"
CLIENT_ID = "omarchy"
REDIRECT_HOST = "127.0.0.1"
TIMEOUT_SECONDS = 300


def generate_pkce_pair():
    """Generate PKCE code_verifier and code_challenge (S256)."""
    code_verifier = secrets.token_urlsafe(32)[:128]
    digest = hashlib.sha256(code_verifier.encode("ascii")).digest()
    code_challenge = base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
    return code_verifier, code_challenge


def exchange_code(code, code_verifier, hostname=None):
    """Exchange authorization code for access token."""
    payload = {
        "code": code,
        "codeVerifier": code_verifier,
        "clientId": CLIENT_ID,
    }
    if hostname:
        payload["hostname"] = hostname

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        OAUTH_TOKEN_URL,
        data=data,
        # Cloudflare blocks the default "Python-urllib/x.y" User-Agent outright
        # (error 1010) before the request ever reaches the app.
        headers={"Content-Type": "application/json", "User-Agent": "keeply-omarchy/0.1.0"},
        method="POST",
    )

    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


class OAuthHandler(http.server.BaseHTTPRequestHandler):
    """HTTP handler that captures the OAuth callback."""

    code = None
    state = None
    error = None
    done_event = None

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)

        if "code" in params and "state" in params:
            OAuthHandler.code = params["code"][0]
            OAuthHandler.state = params["state"][0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(
                b"<!DOCTYPE html><html><body><h2>Connected!</h2>"
                b"<p>You can close this tab and return to Omarchy.</p>"
                b"<script>setTimeout(function(){window.close()},2000);</script>"
                b"</body></html>"
            )
        elif "error" in params:
            OAuthHandler.error = params.get("error_description", params["error"][0])
            self.send_response(400)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(f"<h2>Error: {OAuthHandler.error}</h2>".encode())
        else:
            self.send_response(404)
            self.end_headers()

        if OAuthHandler.done_event:
            OAuthHandler.done_event.set()

    def log_message(self, format, *args):
        pass  # Suppress HTTP server logs


def main():
    code_verifier, code_challenge = generate_pkce_pair()
    state = secrets.token_urlsafe(16)

    # Find a free port
    with socketserver.TCPServer((REDIRECT_HOST, 0), OAuthHandler) as httpd:
        port = httpd.server_address[1]
        redirect_uri = f"http://{REDIRECT_HOST}:{port}/callback"

        # Build authorize URL
        auth_params = urllib.parse.urlencode(
            {
                "client_id": CLIENT_ID,
                "code_challenge": code_challenge,
                "code_challenge_method": "S256",
                "redirect_uri": redirect_uri,
                "state": state,
            }
        )
        auth_url = f"{OAUTH_AUTHORIZE_URL}?{auth_params}"

        # Open browser
        try:
            subprocess.Popen(["xdg-open", auth_url])
        except FileNotFoundError:
            try:
                subprocess.Popen(["open", auth_url])
            except FileNotFoundError:
                print(json.dumps({"error": "Could not open browser"}), file=sys.stderr)
                sys.exit(1)

        # Set up timeout and wait for callback
        OAuthHandler.done_event = threading.Event()

        def timeout_handler():
            OAuthHandler.done_event.wait(timeout=TIMEOUT_SECONDS)
            if not OAuthHandler.done_event.is_set():
                OAuthHandler.error = "Timeout waiting for authorization"
                OAuthHandler.done_event.set()

        timer = threading.Thread(target=timeout_handler, daemon=True)
        timer.start()

        # Serve until callback or timeout
        httpd.timeout = 1
        while not OAuthHandler.done_event.is_set():
            httpd.handle_request()

    # Handle result
    if OAuthHandler.error:
        print(json.dumps({"error": OAuthHandler.error}), file=sys.stderr)
        sys.exit(1)

    if not OAuthHandler.code:
        print(json.dumps({"error": "No authorization code received"}), file=sys.stderr)
        sys.exit(1)

    # Get hostname for key naming
    try:
        hostname = socket.gethostname()
    except Exception:
        hostname = None

    # Exchange code for token
    try:
        result = exchange_code(OAuthHandler.code, code_verifier, hostname)
        print(json.dumps(result))
    except Exception as e:
        print(json.dumps({"error": str(e)}), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
