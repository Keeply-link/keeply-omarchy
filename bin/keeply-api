#!/usr/bin/env python3
"""Keeply API helper for Omarchy plugin.

Performs a single Keeply API request outside the long-lived shell process.
Reads one line of JSON from stdin describing the request, makes the HTTP
call, and prints the (byte-capped) response body as compact JSON on stdout.

QML's own XMLHttpRequest can't bound this itself: Qt materializes every
received byte into responseText as it streams in, inside the shared shell
process, before any JS callback gets a chance to inspect or abort it. Doing
the read here, in a short-lived subprocess, means an oversized or hostile
response is capped by this process's own socket read and never enters the
shell's memory at all.

Protocol:
  stdin:  {"method": "GET", "path": "/bookmarks?...", "token": "...", "body": null}
  stdout (exit 0): the response body, re-serialized as compact single-line JSON
  stderr (exit != 0): a short error message; see exit codes below

Exit codes:
  0  success
  2  response exceeded the byte cap
  3  non-2xx HTTP status (stderr is "http_status:<code>")
  4  any other failure (bad request line, network error, invalid JSON body)
"""

import json
import sys
import urllib.error
import urllib.request

API_BASE = "https://api.keeply.tools"

# Every response is a bounded list of bookmarks/folders/tags or a single
# small object; 5 MiB is generous even for a large account while still
# bounding what this process will ever hold in memory.
MAX_RESPONSE_BYTES = 5 * 1024 * 1024


def read_capped(resp, max_bytes):
    """Read a response body up to max_bytes, raising if it's exceeded.

    resp.read() with no argument reads the entire body regardless of size;
    this reads in bounded chunks so an oversized or never-ending response
    can't be accepted into memory.
    """
    chunks = []
    total = 0
    while True:
        chunk = resp.read(65536)
        if not chunk:
            break
        total += len(chunk)
        if total > max_bytes:
            raise ValueError(f"Response exceeded {max_bytes} byte limit")
        chunks.append(chunk)
    return b"".join(chunks)


def make_request(method, path, token, body):
    """Perform the HTTP call and return (status, capped_body_bytes)."""
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(
        API_BASE + path,
        data=data,
        headers={
            "Authorization": "ApiKey " + token,
            "Content-Type": "application/json",
            # Cloudflare blocks the default "Python-urllib/x.y" User-Agent
            # outright (error 1010) before the request ever reaches the app.
            "User-Agent": "keeply-omarchy/0.1.0",
        },
        method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, read_capped(resp, MAX_RESPONSE_BYTES)
    except urllib.error.HTTPError as e:
        # Drain (and still cap) the error body, but its content is never
        # surfaced — only the status code is, matching this plugin's
        # existing "Request failed (<status>)" wording.
        try:
            read_capped(e, MAX_RESPONSE_BYTES)
        except ValueError:
            pass
        return e.code, b""


def main():
    try:
        request_line = sys.stdin.readline()
        payload = json.loads(request_line)
        method = payload["method"]
        path = payload["path"]
        token = payload["token"]
        body = payload.get("body")
    except Exception as e:
        print("Invalid request: " + str(e), file=sys.stderr)
        sys.exit(4)

    try:
        status, response_bytes = make_request(method, path, token, body)
    except ValueError:
        print("Response too large", file=sys.stderr)
        sys.exit(2)
    except Exception as e:
        print(str(e), file=sys.stderr)
        sys.exit(4)

    if status < 200 or status >= 300:
        print("http_status:" + str(status), file=sys.stderr)
        sys.exit(3)

    try:
        parsed = json.loads(response_bytes.decode("utf-8"))
    except Exception:
        print("Invalid response from server", file=sys.stderr)
        sys.exit(4)

    # Re-serialized compact (single-line) so the QML side can safely
    # reconstruct it from newline-delimited process output.
    print(json.dumps(parsed))
    sys.exit(0)


if __name__ == "__main__":
    main()
